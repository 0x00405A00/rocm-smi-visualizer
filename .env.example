# Copy this file to .env and adjust values.
#
# SERVER MODE  (run with --api):
#   rocm-smi is called locally; data is served via REST API.
#
# CLIENT MODE  (API_URL is set, no --api needed):
#   UI fetches all data from the given API URL.
#   rocm-smi is NOT called locally → enables remote GPU monitoring.
#
# Both modes can coexist: start with --api on the GPU machine,
# then point a second instance at that URL via API_URL.

# ── Authentication (required for both modes) ─────────────────
API_TOKEN=change-me-to-a-secure-random-token

# ── Server settings (used when --api is passed) ───────────────
API_HOST=0.0.0.0
API_PORT=8080

# ── Client settings (set this to enable remote UI) ────────────
# API_URL=http://192.168.1.100:8080
